{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bikcalculator",
  // Static site: no Worker code, Cloudflare serves the built files directly. The calculator runs in the browser
  // (public/wp-content/plugins/bik-calculator/assets/bikc.js).
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
